{
  "manifest_version": 3,
  "name": "TekaSend",
  "version": "0.1.0",
  "description": "Find and visually mask sensitive information on web pages.",
  "icons": {
    "16": "icons/tekasend-logo-16.png",
    "32": "icons/tekasend-logo-32.png",
    "48": "icons/tekasend-logo-48.png",
    "128": "icons/tekasend-logo-128.png"
  },
  "permissions": ["storage", "contextMenus", "offscreen"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TekaSend",
    "default_icon": {
      "16": "icons/tekasend-logo-16.png",
      "32": "icons/tekasend-logo-32.png",
      "48": "icons/tekasend-logo-48.png",
      "128": "icons/tekasend-logo-128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end", "all_frames": true, "match_origin_as_fallback": true }]
}
