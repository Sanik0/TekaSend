{
  "manifest_version": 3,
  "name": "TekaSend",
  "version": "0.1.0",
  "description": "Find and visually mask sensitive information on web pages.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://api.openai.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": { "default_popup": "popup.html", "default_title": "TekaSend" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end", "all_frames": true, "match_origin_as_fallback": true }]
}
